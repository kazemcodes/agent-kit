{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fixindex.local/schema/device-payload.schema.json",
  "title": "FixIndex device ingestion payload",
  "type": "object",
  "required": ["device", "provenance"],
  "additionalProperties": true,
  "properties": {
    "schema_version": {
      "type": "integer",
      "const": 1
    },
    "device": {
      "type": "object",
      "required": ["brand", "model_family", "platform"],
      "additionalProperties": false,
      "properties": {
        "brand": { "type": "string", "maxLength": 80 },
        "model_family": { "type": "string", "maxLength": 120 },
        "platform": { "type": "string", "enum": ["Android", "iOS"] },
        "slug": {
          "type": "string",
          "maxLength": 120,
          "pattern": "^[a-z0-9-]+$",
          "description": "Stable identifier. Defaults to a slug of brand and model."
        },
        "release_year": { "type": "integer", "minimum": 2000, "maximum": 2100 },
        "board_identifier": {
          "type": "string",
          "maxLength": 80,
          "description": "Service or board code, e.g. SM-A105F or 820-02055-A."
        },
        "aliases": {
          "type": "array",
          "items": { "type": "string", "maxLength": 80 }
        },
        "specs": {
          "type": "object",
          "description": "Free-form spec keys such as cpu, display, ram, storage, battery.",
          "additionalProperties": true
        },
        "known_issues": {
          "type": "array",
          "items": { "type": "string" }
        },
        "schematic_url": { "type": "string", "format": "uri" },
        "profile": {
          "type": "object",
          "description": "Agent-written repair dossier rendered on the device page. Sections merge independently: sending failure_modes replaces that list, leaving verdict and evidence untouched.",
          "additionalProperties": false,
          "properties": {
            "verdict": {
              "type": "string",
              "maxLength": 1200,
              "description": "Two or three sentences: what fails first and whether the device is worth repairing."
            },
            "overview": { "type": "string", "maxLength": 6000 },
            "failure_modes": {
              "type": "array",
              "items": {
                "type": "object",
                "required": ["title"],
                "additionalProperties": false,
                "properties": {
                  "title": { "type": "string", "maxLength": 180 },
                  "severity": { "enum": ["common", "occasional", "rare", "design-flaw"] },
                  "confidence": { "enum": ["verified", "community", "single-report"] },
                  "symptoms": { "type": "array", "items": { "type": "string", "maxLength": 600 } },
                  "mechanism": { "type": "string", "maxLength": 4000 },
                  "diagnose": { "type": "array", "items": { "type": "string", "maxLength": 900 } },
                  "fix": { "type": "string", "maxLength": 4000 },
                  "risk": { "type": "string", "maxLength": 900 },
                  "components": { "type": "array", "items": { "type": "string", "maxLength": 80 } },
                  "sources": {
                    "type": "array",
                    "items": { "type": "string", "maxLength": 80 },
                    "description": "Evidence ids declared in profile.evidence."
                  }
                }
              }
            },
            "checks": {
              "type": "array",
              "items": {
                "type": "object",
                "required": ["label"],
                "additionalProperties": false,
                "properties": {
                  "label": { "type": "string", "maxLength": 180 },
                  "tool": { "type": "string", "maxLength": 80 },
                  "expect": { "type": "string", "maxLength": 900 },
                  "sources": { "type": "array", "items": { "type": "string", "maxLength": 80 } }
                }
              }
            },
            "error_codes": {
              "type": "array",
              "items": {
                "type": "object",
                "required": ["code"],
                "additionalProperties": false,
                "properties": {
                  "code": { "type": "string", "maxLength": 40 },
                  "tool": { "type": "string", "maxLength": 60 },
                  "meaning": { "type": "string", "maxLength": 1200 },
                  "first_step": { "type": "string", "maxLength": 1200 },
                  "hardware_cause": { "type": "string", "maxLength": 1200 },
                  "sources": { "type": "array", "items": { "type": "string", "maxLength": 80 } }
                }
              }
            },
            "battery": {
              "type": "object",
              "additionalProperties": true,
              "properties": {
                "capacity": { "type": "string", "maxLength": 120 },
                "chemistry": { "type": "string", "maxLength": 120 },
                "connector": { "type": "string", "maxLength": 120 },
                "adhesive": { "type": "string", "maxLength": 600 },
                "time_required": { "type": "string", "maxLength": 80 },
                "steps": { "type": "array", "items": { "type": "string", "maxLength": 600 } },
                "risk": { "type": "string", "maxLength": 900 },
                "sources": { "type": "array", "items": { "type": "string", "maxLength": 80 } }
              }
            },
            "parts": {
              "type": "array",
              "items": {
                "type": "object",
                "required": ["name"],
                "additionalProperties": false,
                "properties": {
                  "name": { "type": "string", "maxLength": 160 },
                  "type": { "type": "string", "maxLength": 60 },
                  "note": { "type": "string", "maxLength": 900 }
                }
              }
            },
            "media": {
              "type": "array",
              "items": {
                "type": "object",
                "required": ["url", "title"],
                "additionalProperties": false,
                "properties": {
                  "url": { "type": "string", "format": "uri" },
                  "title": { "type": "string", "maxLength": 200 },
                  "kind": { "type": "string", "maxLength": 40, "examples": ["video", "youtube", "guide", "teardown"] },
                  "shows": { "type": "string", "maxLength": 900 },
                  "video_id": { "type": "string", "maxLength": 40 },
                  "channel": { "type": "string", "maxLength": 120 },
                  "duration_seconds": { "type": "integer", "minimum": 0 },
                  "views": { "type": "integer", "minimum": 0 },
                  "thumbnail_url": { "type": "string", "format": "uri" },
                  "topic": { "type": "string", "maxLength": 80 },
                  "language": { "type": "string", "maxLength": 8 }
                }
              }
            },
            "community": {
              "type": "array",
              "items": {
                "type": "object",
                "required": ["source", "url", "excerpt"],
                "additionalProperties": false,
                "properties": {
                  "source": { "type": "string", "maxLength": 120 },
                  "url": { "type": "string", "format": "uri" },
                  "excerpt": { "type": "string", "maxLength": 2000 },
                  "topic": { "type": "string", "maxLength": 80 },
                  "author": { "type": "string", "maxLength": 120 },
                  "date": { "type": "string", "format": "date" }
                }
              }
            },
            "diode_tables": {
              "type": "array",
              "items": {
                "type": "object",
                "required": ["connector", "pin"],
                "additionalProperties": false,
                "properties": {
                  "connector": { "type": "string", "maxLength": 120 },
                  "pin": { "type": "string", "maxLength": 40 },
                  "net": { "type": "string", "maxLength": 80 },
                  "normal": { "type": "string", "maxLength": 40 },
                  "short": { "type": "string", "maxLength": 40 },
                  "open": { "type": "string", "maxLength": 40 },
                  "notes": { "type": "string", "maxLength": 600 },
                  "sources": { "type": "array", "items": { "type": "string", "maxLength": 80 } }
                }
              }
            },
            "ic_crossref": {
              "type": "array",
              "items": {
                "type": "object",
                "required": ["ic"],
                "additionalProperties": false,
                "properties": {
                  "ic": { "type": "string", "maxLength": 80 },
                  "function": { "type": "string", "maxLength": 160 },
                  "donors": { "type": "array", "items": { "type": "string", "maxLength": 120 } },
                  "sources": { "type": "array", "items": { "type": "string", "maxLength": 80 } }
                }
              }
            },
            "firmware": {
              "type": "array",
              "items": {
                "type": "object",
                "required": ["name", "url"],
                "additionalProperties": false,
                "properties": {
                  "name": { "type": "string", "maxLength": 160 },
                  "kind": { "type": "string", "enum": ["rom", "qcn", "eng-boot", "dump", "flash-file", "other"] },
                  "version": { "type": "string", "maxLength": 80 },
                  "region": { "type": "string", "maxLength": 80 },
                  "url": { "type": "string", "format": "uri" },
                  "verified": { "type": "boolean" },
                  "sources": { "type": "array", "items": { "type": "string", "maxLength": 80 } }
                }
              }
            },
            "schematics": {
              "type": "array",
              "items": {
                "type": "object",
                "required": ["title", "url"],
                "additionalProperties": false,
                "properties": {
                  "title": { "type": "string", "maxLength": 160 },
                  "kind": { "type": "string", "enum": ["pdf", "boardview", "photo", "other"] },
                  "board_id": { "type": "string", "maxLength": 80 },
                  "url": { "type": "string", "format": "uri" },
                  "sources": { "type": "array", "items": { "type": "string", "maxLength": 80 } }
                }
              }
            },
            "evidence": {
              "type": "array",
              "items": {
                "type": "object",
                "required": ["id", "url"],
                "additionalProperties": false,
                "properties": {
                  "id": { "type": "string", "maxLength": 80, "pattern": "^[a-z0-9-]+$" },
                  "url": { "type": "string", "format": "uri" },
                  "title": { "type": "string", "maxLength": 200 },
                  "publisher": { "type": "string", "maxLength": 120 },
                  "retrieved_at": { "type": "string", "format": "date" },
                  "supports": {
                    "type": "string",
                    "maxLength": 900,
                    "description": "What this source actually proves, in one sentence."
                  }
                }
              }
            },
            "review": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "status": { "enum": ["agent_draft", "reviewed", "verified", "disputed"] },
                "agent": { "type": "string", "maxLength": 120 },
                "reviewed_by": { "type": ["string", "null"], "maxLength": 120 },
                "reviewed_at": { "type": ["string", "null"], "format": "date" },
                "notes": { "type": "string", "maxLength": 2000 }
              }
            }
          }
        }
      }
    },
    "variants": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["hardware_code"],
        "additionalProperties": false,
        "properties": {
          "hardware_code": { "type": "string", "maxLength": 80 },
          "market_region": { "type": "string", "maxLength": 80 },
          "chipset": { "type": "string", "maxLength": 120 }
        }
      }
    },
    "testpoints": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["title", "mode_type", "instructions"],
        "additionalProperties": false,
        "properties": {
          "title": { "type": "string", "maxLength": 160 },
          "slug": { "type": "string", "maxLength": 180, "pattern": "^[a-z0-9-]+$" },
          "mode_type": {
            "type": "string",
            "maxLength": 60,
            "examples": ["EDL (9008)", "ISP / eMMC", "Force DFU", "BROM Mode", "Diode Lines"]
          },
          "instructions": { "type": "string" },
          "voltage_reading": {
            "type": "string",
            "maxLength": 255,
            "description": "Measured value with units, e.g. 'Diode Mode: 0.435V'."
          },
          "safety_warning": { "type": "string" }
        }
      }
    },
    "provenance": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["url"],
        "additionalProperties": false,
        "properties": {
          "url": { "type": "string", "format": "uri" },
          "title": { "type": "string", "maxLength": 200 },
          "captured_at": { "type": "string", "format": "date-time" }
        }
      }
    }
  }
}
